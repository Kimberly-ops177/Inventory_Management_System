# =====================================================
# PRODUCTION Environment Configuration
# =====================================================

# Application
APP_ENV=production
APP_DEBUG=false  # MUST be false in production
APP_URL=https://inventory.example.com
APP_TIMEZONE=Africa/Nairobi

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=inventory_production
DB_USERNAME=inventory_prod
DB_PASSWORD=USE_VERY_STRONG_PASSWORD_HERE

# Session
SESSION_SECURE=true  # MUST be true with HTTPS
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Strict  # Strict for production
SESSION_LIFETIME=7200

# Logging
LOG_LEVEL=error  # Only log errors in production
LOG_PATH=storage/logs

# Security
APP_KEY=GENERATE_SECURE_RANDOM_KEY_HERE

# File Upload
UPLOAD_MAX_SIZE=10485760

# Pagination
ITEMS_PER_PAGE=20

# =====================================================
# IMPORTANT SECURITY NOTES
# =====================================================
# 1. Generate APP_KEY: php -r "echo bin2hex(random_bytes(32));"
# 2. Use strong database password (20+ characters)
# 3. Enable firewall on database port
# 4. Set up daily backups (cron: 0 2 * * * /path/to/backup.sh)
# 5. Monitor storage/logs/error.log regularly
# 6. Keep this file secure (chmod 600 .env)
# 7. Never commit .env to version control
