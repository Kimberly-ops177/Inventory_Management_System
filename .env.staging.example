# =====================================================
# STAGING Environment Configuration
# =====================================================

# Application
APP_ENV=staging
APP_DEBUG=true  # Enable for debugging in staging
APP_URL=https://staging.inventory.example.com
APP_TIMEZONE=Africa/Nairobi

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=inventory_staging
DB_USERNAME=inventory_staging
DB_PASSWORD=CHANGE_ME_STAGING_PASSWORD

# Session
SESSION_SECURE=true  # Use HTTPS
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax
SESSION_LIFETIME=7200

# Logging
LOG_LEVEL=debug
LOG_PATH=storage/logs

# Security
APP_KEY=GENERATE_RANDOM_KEY_HERE

# File Upload
UPLOAD_MAX_SIZE=10485760

# Pagination
ITEMS_PER_PAGE=20
