# =====================================================
# Inventory Management System - Environment Configuration
# =====================================================
# Copy this file to .env and configure with your settings

# Application Environment
# Options: local, production
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Africa/Nairobi

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventory_db
DB_USERNAME=inventory_user
DB_PASSWORD=inventory_pass

# Session Configuration
# IMPORTANT: Set SESSION_SECURE=true when using HTTPS in production
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax
SESSION_LIFETIME=7200

# Logging Configuration
LOG_LEVEL=debug
LOG_PATH=storage/logs

# Security
# Generate a secure random key: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# File Upload Settings
UPLOAD_MAX_SIZE=10485760

# Pagination
ITEMS_PER_PAGE=20

# =====================================================
# PRODUCTION SETTINGS
# =====================================================
# Uncomment and configure these for production deployment:
#
# APP_ENV=production
# APP_DEBUG=false
# SESSION_SECURE=true
# LOG_LEVEL=error
# APP_KEY=<generate-secure-key-here>
#
# Database (use strong credentials)
# DB_USERNAME=<secure-username>
# DB_PASSWORD=<strong-password>

# =====================================================
# OPTIONAL: Email Configuration
# =====================================================
# Uncomment to enable email notifications (future feature)
# MAIL_DRIVER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@inventory.local
# MAIL_FROM_NAME="Inventory System"
