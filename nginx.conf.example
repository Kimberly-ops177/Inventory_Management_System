# =====================================================
# Inventory Management System - Nginx Configuration
# =====================================================
# Place this in: /etc/nginx/sites-available/inventory
# Create symlink: ln -s /etc/nginx/sites-available/inventory /etc/nginx/sites-enabled/
# Test config: sudo nginx -t
# Reload: sudo systemctl reload nginx

server {
    listen 80;
    listen [::]:80;

    # Replace with your domain
    server_name inventory.example.com;

    # Document root - point to the public directory
    root /var/www/inventory/public;
    index index.php index.html;

    # Logging
    access_log /var/log/nginx/inventory_access.log;
    error_log /var/log/nginx/inventory_error.log;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Disable access to hidden files
    location ~ /\. {
        deny all;
    }

    # Deny access to sensitive files
    location ~* \.(env|json|lock)$ {
        deny all;
    }

    # Main location block - route everything through index.php
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # PHP-FPM Configuration
    location ~ \.php$ {
        # Prevent PHP scripts from being executed in uploads directory
        location ~ ^/uploads/.*\.php$ {
            deny all;
        }

        fastcgi_pass unix:/var/run/php/php8.2-fpm.sock;  # Adjust PHP version as needed
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;

        # Timeouts
        fastcgi_read_timeout 300;
        fastcgi_send_timeout 300;

        # Buffer sizes
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }

    # Static files caching
    location ~* \.(jpg|jpeg|png|gif|ico|svg|css|js|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Deny access to backup and log files
    location ~* \.(bak|log|old|sql|backup)$ {
        deny all;
    }

    # Client body size limit
    client_max_body_size 10M;
}

